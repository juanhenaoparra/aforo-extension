{
  "manifest_version": 3,
  "name": "Aforo — Contador de personas",
  "version": "1.0.0",
  "description": "Cuenta personas en un local físico con un solo botón. Ventana flotante siempre encima, atajos de teclado y sincronización entre dispositivos.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Aforo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "commands": {
    "count-in": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "Contar una persona"
    },
    "open-floating": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Abrir la ventana flotante"
    }
  }
}
